# Copy to .env and fill in. .env is gitignored; this file stays blank and committed.
# Local infrastructure credentials have working defaults in compose.yaml, so a fresh
# clone runs with no .env at all -- these exist to override, not to enable.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

SHUSH_DB_URL=
SHUSH_DB_USER=
SHUSH_DB_PASSWORD=
SHUSH_PORT=
