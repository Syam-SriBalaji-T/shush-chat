# Copy to .env and fill in. .env is gitignored; this file stays blank and committed.
#
# Every key here also has a default in compose.yaml, so a fresh clone runs with one command and
# no .env at all. Set these to override those defaults on your machine.
#
# For anything real, credentials do NOT belong in a file on disk -- use a secret manager.
#
# Avoid $ (compose interpolates it), # (starts a comment), quotes, backslashes, and : @ /
# (they break the moment a URL is built from the value).

# --- PostgreSQL -------------------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
SHUSH_DB_USER=
SHUSH_DB_PASSWORD=

# --- Redis ------------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=
SHUSH_REDIS_PASSWORD=

# --- Redpanda ---------------------------------------------------------------------------
KAFKA_USER=
KAFKA_PASSWORD=
SHUSH_KAFKA_USER=
SHUSH_KAFKA_PASSWORD=

# --- Elasticsearch ----------------------------------------------------------------------
ELASTICSEARCH_PASSWORD=
SHUSH_ELASTICSEARCH_USER=
SHUSH_ELASTICSEARCH_PASSWORD=

# --- MinIO / S3 -------------------------------------------------------------------------
# MinIO refuses a root password shorter than 8 characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
SHUSH_S3_ACCESS_KEY=
SHUSH_S3_SECRET_KEY=

# --- Grafana ----------------------------------------------------------------------------
GRAFANA_USER=
GRAFANA_PASSWORD=

# --- Application ------------------------------------------------------------------------
# NOT a password: an HS256 signing key, at least 32 bytes or the app refuses to start.
# Generate with: openssl rand -base64 48
SHUSH_JWT_SECRET=

# Exposes the harness-only conversation endpoint. Leave blank unless benchmarking.
SHUSH_DEV_ENDPOINTS=

# Bind nginx beyond loopback for LAN testing. Leave blank for 127.0.0.1.
NGINX_BIND=
NGINX_PORT=
