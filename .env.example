# shush-chat credentials -- copy to .env and fill in
#
# Gitignored, never committed. Credentials in git history are permanent and unretractable,
# even in a private repository.
#
# Every value here also has a default in the compose files, so a fresh clone still starts.
# These override those defaults on this machine.
#
# Values are single-quoted so the file can also be `source`d from a shell -- without quotes a
# password containing & or * is mangled or silently backgrounds part of the line.
#
# For anything real these do NOT belong in a file on disk: a .env on a production host sits in
# backups, in `docker inspect` output and in any process listing. Use a secret manager there.
#
# 10 values below are SHARED with syamdev-platform/.env and must match. If chat stops
# authenticating after you rotate one, this is why.


# --- shared datastores (issued by syamdev-platform) ------------------------------
SHUSH_DB_NAME=   # shared
SHUSH_DB_USER=   # shared
SHUSH_DB_PASSWORD=   # shared
SHUSH_REDIS_PASSWORD=   # shared
SHUSH_KAFKA_USER=   # shared
SHUSH_KAFKA_PASSWORD=   # shared
SHUSH_ES_USER=   # shared
SHUSH_ES_PASSWORD=   # shared
SHUSH_S3_ACCESS_KEY=   # shared
SHUSH_S3_SECRET_KEY=   # shared

# --- application only ------------------------------------------------------------
SHUSH_JWT_SECRET=
SHUSH_DEV_ENDPOINTS=
